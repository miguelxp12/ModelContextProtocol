# Configuración del servidor
PORT=3000

# Límites de solicitudes
MAX_REQUEST_SIZE=10MB
RATE_LIMIT=100

# Opciones de seguridad
ENABLE_AUTH=false
# JWT_SECRET=tu_clave_secreta

# Ajustes de caché
CACHE_ENABLED=true
CACHE_TTL=3600

# Opciones de logging
LOG_LEVEL=info
# LOG_FILE=./logs/mcp-server.log
